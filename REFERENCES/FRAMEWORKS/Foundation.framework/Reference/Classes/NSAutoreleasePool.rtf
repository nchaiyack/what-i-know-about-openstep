¬}\pard \s12 \li1463 \fi0 \ri1007 \ql NSAutoreleasePool\
\fs80\
\f1 \b0 \fs28 \pard \s30 \li4231 \fi-2719 \ri1007 \ql \tx4233 \f0 \b \fs24 Inherits From:\tab \f1 \b0 \fs28 NSObject\
\fs20\
