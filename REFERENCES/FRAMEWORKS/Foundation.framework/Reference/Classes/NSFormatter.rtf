\pard \s20 \li1915 \fi0 \ri1007 \ql \tx2413 \tx2889 \tx3421 \tx3953 \tx4457 \tx4933 \tx7005 \tx7509 \tx8013 \tx8517 \tx9021 \tx9525 \tx10029 \tx10533 \tx11037 \tx11513 \f2 \fs24 - (BOOL)getObjectValue:(id *)obj forString:(NSString *)string errorDescription:(NSString **)error \
\{\
    float floatResult;\
    NSScanner *scanner;\
    BOOL retval = NO;\
    NSString *err = nil;\
\
    scanner = [NSScanner scannerWithString:string];\
    if ([string hasPrefix:@"$"]) [scanner setScanLocation:1];    \
    if ([scanner scanFloat:&floatResult] \
\fi0 \tab \tab && ([scanner scanLocation] == [string length] )) \{\
\fi0        if (obj) \{\
          *obj = [NSNumber numberWithFloat:floatResult];\
          \{\
             retval = YES;\
        \tab \tab   \}\
       \} else \{\
          err = NSLocalizedString(@"Couldn't convert to float");\
       \}\
    \}\
    if (error) \{\
        *error = err;\
    \}\
    return retval;\
\}\
