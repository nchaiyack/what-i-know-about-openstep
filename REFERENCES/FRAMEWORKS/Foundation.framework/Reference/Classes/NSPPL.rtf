\f0 \fs28 \pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 {{\NeXTHelpMarker16613 \markername NS_DEV_DOCFOR:objc_method:[NSPPL-pplWithPath:fromPPLData:readOnly:];}
¬}\pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 {{\NeXTHelpMarker16617 \markername NS_DEV_DOCFOR:objc_method:[NSPPL;}
¬}\pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 pplWithPath:fromPPLData:readOnly:\
\fs6\
\pard \s39 \li2520 \fi-604 \ri1007 \ql \f1 \b0 \fs28 + (NSPPL *)\b pplWithPath:\b0 (NSString *)\i path \
\fi0 \b \i0 fromPPLData:\b0 (NSData *)\i pplData \
\fi0 \b \i0 readOnly:\b0 (BOOL)\i readOnlyFlag\i0  \
\fs14\
\fs28 \pard \s3 \li1512 \fi0 \ri1007 \ql \tx3603 \tx3981 \tx4359 Given a \i path\i0 , reads or creates an NSPPL that is identical in every way, except for mutability, to the NSPPL represented by \i pplData\i0 . \i readOnlyFlag\i0  indicates whether the new NSPPL can be modified; the new NSPPL doesn\'27t have to have the same mutability or immutability as the NSPPL specified in the \i pplData\i0  argument. Returns the new NSPPL object or \b nil\b0  if the file can\'27t be read. \
\fs14\
\fs28 An NSPPL is saved when it\'27s created; you don\'27t need to explicitly save it. You can use this method to make local back ups of a remote NSPPL.\
\fs14\
\fs28 When you use this method or any of the other NSPPL methods that take NSData arguments, you use \b contentsAsData\b0  to return a read-only snapshot of an NSPPL as an NSData object, for example:\
\fs14\
\pard \s20 \li1915 \fi0 \ri1007 \ql \tx2413 \tx2889 \tx3421 \tx3953 \tx4457 \tx4933 \tx7005 \tx7509 \tx8013 \tx8517 \tx9021 \tx9525 \tx10029 \tx10533 \tx11037 \tx11513 \f2 \fs24 NSPPL *originalPPL;  /* Assume this exists. */\
NSString *aPath;     /* Assume this exists. */\
NSPPL *pplCopy = [NSPPL pplWithPath:aPath\
    fromPPLData:[originalPPL contentsAsData] readOnly:NO];\
\fs14\
\f1 \fs28 \pard \s58 \li2804 \fi-1292 \ri1007 \ql \tx2799 \tx3282 \tx3771 \f0 \b \fs24 See also:\tab \f1 \b0 \fs28 +\'80\b pplWithPath:create:readOnly:\b0 ,\b  \b0 +\'80\b propertyListWithPPLData: \
\fs14\
\fs46\
\f0 \fs28 \pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 {{\NeXTHelpMarker18612 \markername NS_DEV_DOCFOR:objc_method:[NSPPL-propertyListWithPPLData:];}
¬}\pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 {{\NeXTHelpMarker18616 \markername NS_DEV_DOCFOR:objc_method:[NSPPL;}
¬}\pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 propertyListWithPPLData:\
\fs6\
\pard \s39 \li2520 \fi-604 \ri1007 \ql \f1 \b0 \fs28 + (NSDictionary *)\b propertyListWithPPLData:\b0 (NSData *)\i pplData\i0  \
\fs14\
\fs28 \pard \s3 \li1512 \fi0 \ri1007 \ql \tx3603 \tx3981 \tx4359 Returns an immutable root dictionary that gives you access to a snapshot of the NSPPL specified in the \i pplData\i0  argument.\
\fs14\
\fs28 This method is similar to \b rootDictionary\b0 , in that both methods return a root dictionary object that gives you access to an NSPPL. However, while \b rootDictionary\b0  returns an NSMutableDictionary that allows you to modify the associated NSPPL (so long as the NSPPL itself is mutable), \b propertyListWithPPLData:\b0  always returns an immutable NSDictionary whose associated NSPPL can\'27t be modified. This method is a very fast way of getting a read-only snapshot of an NSPPL.\
\fs14\
\pard \s58 \li2804 \fi-1292 \ri1007 \ql \tx2799 \tx3282 \tx3771 \fs28 \f0 \b \fs24 See also:\tab \f1 \b0 \fs28 \i  \i0 +\'80\b pplWithPath:fromPPLData:readOnly:\b0 ,\b  \b0 +\'80\b pplWithPath:create:readOnly:\b0 , \f3 -\f1 \'80\b rootDictionary\
\fs14\
