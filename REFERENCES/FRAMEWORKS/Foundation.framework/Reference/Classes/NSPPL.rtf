\fs6\
\s39 \li2520 \fi-604 \f1 \b0 \fs28 + (NSPPL *)\b pplWithPath:\b0 (NSString *)\i path \
\fi0 \b \i0 create:\b0 (BOOL)\i createFlag \
\fi0 \b \i0 readOnly:\b0 (BOOL)\i readOnlyFlag\i0  \
\fs14\
\fs28 \pard \s3 \li1512 \fi0 \ri1007 \ql \tx3603 \tx3981 \tx4359 Given a\i  path\i0 , reads the NSPPL stored in it or creates a new one, where \i readOnlyFlag\i0  indicates whether the NSPPL can be changed, and \i createFlag\i0  indicates whether the NSPPL should be created if it doesn\'27t already exist. Returns the new NSPPL object or \b nil\b0  if the file can\'27t be read. \
\fs14\
\pard \s58 \li2804 \fi-1292 \ri1007 \ql \tx2799 \tx3282 \tx3771 \fs28 \f0 \b \fs24 See also:\tab \f1 \b0 \fs28 \i  \i0 +\'80\b pplWithPath:fromPPLData:readOnly:\b0 ,\b  \b0 +\'80\b propertyListWithPPLData:\
