\f0 \b \fs28 \pard \s40 \li1512 \fi0 \ri1007 \ql \tx8265 {{\NeXTHelpMarker12012 \markername NS_DEV_DOCFOR:objc_method:[NSBox-setFrameFromContentFrame:];}
