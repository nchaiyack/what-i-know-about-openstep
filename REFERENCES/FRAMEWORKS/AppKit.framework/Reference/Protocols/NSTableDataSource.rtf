\f0 \b \fs28 \pard \s43 \li1512 \fi-503 \ri1007 \ql \tx1512 \tx8265 \f5 \b0 \fs52 p\tab \f0 \b \fs28 {{\NeXTHelpMarker6022 \markername NS_DEV_DOCFOR:objc_method:[NSTableDataSource-tableView:setObjectValue:forTableColumn:row:];}
¬}\pard \s43 \li1512 \fi-503 \ri1007 \ql \tx1512 \tx8265 tableView:setObjectValue:forTableColumn:row:\
\fs6\
\pard \s39 \li2520 \fi-604 \ri1007 \ql \f1 \b0 \fs28 \f3 -\f1 \'80(void)\b tableView:\b0 (NSTableView\'80*)\i aTableView\
\fi0 \b \i0 setObjectValue:\b0 (id)\i anObject\
\fi0 \b \i0 forTableColumn:\b0 (NSTableColumn\'80*)\i aTableColumn\
\fi0 \b \i0 row:\b0 (int)\i rowIndex\
\fs14\
\i0 \fs28 \pard \s3 \li1512 \fi0 \ri1007 \ql \tx3603 \tx3981 \tx4359 Sets an attribute value for the record in \i aTableView\i0  at \i rowIndex\i0 . \i anObject\i0  is the new value, and \i aTableColumn\i0  contains the identifier for the attribute, which you get by using NSTableColumn\'27s \b identifier\b0  method. See the category description for an example.\
