%!PS-Adobe-2.0
%%BoundingBox: (atend)
%%DocumentFonts: Helvetica-Bold

/Helvetica-Bold findfont 8 scalefont setfont 

0.5 setalpha	% Semi-transparent
2 10 moveto 0 setgray (Hello) show
2 2 moveto 0 setgray (World) show

1 setalpha	% Opaque
1 11 moveto 0 setgray (Hello) show
1 3 moveto 0 setgray (World) show

