    ACTIONS = (
        "closeDoc:", 
        "copyItem:", 
        "cutItem:", 
        "newDoc:", 
        "openDoc:", 
        "pasteItem:", 
        "saveDoc:", 
        "showInfo:", 
        "showInspector:", 
        "showPreferences:"
    ); 
    OUTLETS = (inspector); 
    SUPERCLASS = NSObject; 
};
"FirstResponder" = {CATEGORY = LocalActions; };
