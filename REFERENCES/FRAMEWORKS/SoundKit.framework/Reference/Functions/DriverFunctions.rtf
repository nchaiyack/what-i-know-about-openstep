\pard\tx2380\f0\b0\fs28\fi-1560\li2380\fc0\cf0 SUMMARY	Transfer data to and from the DSP \

\fs30 \

\fs28\fi-1960 DECLARED IN	sound/snddriver_client.h\

\fs30 \

\fs28\fi-1940\li2760 SYNOPSIS	kern_return_t 
\b snddriver_dsp_write(
\b0 port_t 
\i commandPort
\i0 , void *
\i buffer
\i0 , int
\b €
