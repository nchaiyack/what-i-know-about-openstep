\pard\tx2380\f0\b0\fs28\fi-1560\li2380\fc0\cf0 SUMMARY	Modify volume or equalization for ATC playback\

\fs30 \

\fs28\fi-1960 DECLARED IN	sound/atcsound.h\

\fs30 \

\fs28\fi-1940\li2760 SYNOPSIS	int 
\b SNDSetATCGain(
\b0 float 
\i level
\b\i0 )\

\pard\b0\fi-380\li2760\fc0\cf0 int 
\b SNDGetATCGain(
\b0 float *
\i level
\b\i0 )\

\b0 int 
\b SNDSetATCEqualizerGains(
\b0 int 
\i numBands
\i0 , float *
\i gains
\b\i0 )\

\b0 int 
\b SNDGetATCEqualizerGains(
\b0 int 
\i numBands
\i0 , float *
\i gains
\b\i0 )\

