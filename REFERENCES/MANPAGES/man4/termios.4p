cfgetospeed(3P),
cfsetispeed(3P),
cfsetospeed(3P),
tcdrain(3P), 
tcflow(3P), 
tcflush(3P),
tcgetattr(3P),
tcsetattr(3P), 
tcsendbreak(3P),
tty(4)
