	<b>NSCompositeCopy</b>,<p>
	<b>NSCompositeSourceOver</b>,<p>
	<b>NSCompositeSourceIn</b>,<p>
	<b>NSCompositeSourceOut</b>,<p>
	<b>NSCompositeSourceAtop</b>,<p>
	<b>NSCompositeDataOver</b>,<p>
	<b>NSCompositeDataIn</b>,<p>
	<b>NSCompositeDataOut</b>,<p>
	<b>NSCompositeDataAtop</b>,<p>
	<b>NSCompositeXOR</b>,<p>
	<b>NSCompositePlusDarker</b>,<p>
